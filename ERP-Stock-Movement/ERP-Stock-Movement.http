@ERP_Stock_Movement_HostAddress = http://localhost:5094

### Create product (you choose the product id)
POST {{ERP_Stock_Movement_HostAddress}}/api/product
Content-Type: application/json

{
  "productId": 123,
  "name": "Widget",
  "price": 19.99
}

### Set stock (same product id)
POST {{ERP_Stock_Movement_HostAddress}}/api/inventory
Content-Type: application/json

{
  "productId": 123,
  "quantity": 100
}

### Create order (same product id)
POST {{ERP_Stock_Movement_HostAddress}}/api/order
Content-Type: application/json

{
  "items": [
    { "productId": 123, "quantity": 5 }
  ]
}
